{
  "meta": {
    "siteName": "learning",
    "visualDirection": "bright-playful",
    "motionLevel": 2,
    "defaultLocale": "mn",
    "locales": ["mn", "en", "ko", "ja"]
  },
  "colors": {
    "brand": {
      "primary": "#5B4DFF",
      "secondary": "#FF6B6B",
      "accent": "#FFD93D"
    },
    "neutral": {
      "50": "#FDF8F3",
      "100": "#F5F0EB",
      "200": "#E5E7EB",
      "300": "#D1D5DB",
      "400": "#9CA3AF",
      "500": "#6B7280",
      "600": "#4B5563",
      "700": "#374151",
      "800": "#1A1A2E",
      "900": "#0F0E1A"
    },
    "semantic": {
      "background": "#FDF8F3",
      "foreground": "#1A1A2E",
      "card": "#FFFFFF",
      "cardForeground": "#1A1A2E",
      "popover": "#FFFFFF",
      "popoverForeground": "#1A1A2E",
      "primary": "#5B4DFF",
      "primaryForeground": "#FFFFFF",
      "secondary": "#FF6B6B",
      "secondaryForeground": "#FFFFFF",
      "muted": "#F5F0EB",
      "mutedForeground": "#6B7280",
      "accent": "#FFD93D",
      "accentForeground": "#1A1A2E",
      "border": "#E5E7EB",
      "input": "#E5E7EB",
      "ring": "#5B4DFF",
      "success": "#22C55E",
      "warning": "#F59E0B",
      "destructive": "#EF4444"
    }
  },
  "typography": {
    "families": {
      "display": "Inter",
      "body": "Inter",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "scale": {
      "xs": "12px",
      "sm": "13px",
      "base": "15px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "22px",
      "3xl": "32px",
      "4xl": "44px",
      "5xl": "64px",
      "6xl": "80px"
    }
  },
  "spacing": {
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "8": "48px",
      "10": "80px",
      "12": "120px"
    },
    "layout": {
      "pageMaxWidth": "1440px",
      "contentMaxWidth": "1000px",
      "sectionPaddingY": "80px",
      "sectionPaddingX": "60px"
    }
  },
  "radius": {
    "sm": "12px",
    "md": "16px",
    "lg": "24px",
    "full": "9999px"
  },
  "shadows": {
    "card": "0 4px 24px rgba(26, 26, 46, 0.06)",
    "cardHover": "0 8px 32px rgba(26, 26, 46, 0.10)",
    "button": "0 2px 8px rgba(91, 77, 255, 0.20)",
    "input": "0 1px 2px rgba(26, 26, 46, 0.04)"
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms",
      "page": "400ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "smooth": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "spring_configs": {
      "cardHover": { "stiffness": 300, "damping": 25 },
      "buttonTap": { "stiffness": 400, "damping": 20 }
    },
    "variants": {
      "fadeInUp": {
        "initial": { "opacity": 0, "y": 24 },
        "animate": { "opacity": 1, "y": 0 },
        "transition": { "duration": 0.4, "ease": "easeOut" }
      },
      "staggerContainer": {
        "staggerChildren": 0.08,
        "delayChildren": 0.1
      },
      "cardHover": {
        "rest": { "y": 0, "scale": 1 },
        "hover": { "y": -4, "scale": 1.02, "transition": { "duration": 0.2 } }
      }
    },
    "gsap_configs": {}
  }
}
